# Ignore modules downloaded by package manager
node_modules/
# Ignore generated files
dist/
types/
cache/
!/*/*/types/
/*/*/types/*
!/*/*/types/config.d.ts
# Ignore lockfiles other than NPM ones
*lock*
!package-lock.json
!package-lock.json.license
# Ignore local packages
*.tgz
# Ignore typedoc files
docs/typedoc/
# Ignore common coverage or test result files formats
*.info
*.xml
# Generic paths rulesets to ignore coverage results
*coverage*/
*coverage*.*
*codecov*/
*codecov*.*